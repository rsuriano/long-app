# --- Phase 1: the AI that makes the basket ---
# OpenRouter. This is the only thing that packages/ai needs. Without it, the AI returns the template basket.
OPENROUTER_API_KEY=
# Any OpenRouter ID. Default: google/gemini-2.5-flash-lite (~4.5 s, ~0.02¢).
# For the demo, anthropic/claude-opus-4.8 makes better baskets at ~1.2¢.
LONG_AI_MODEL=
# low | medium | high | off. Default: low. The cheap models reason and are slow; low makes them much faster.
LONG_AI_REASONING=

# --- Phase 2: real buy ---
# Postgres (Neon in production; any local Postgres is satisfactory). Without it, the app operates,
# but it does not save indices: /api/indices returns 503 and Home shows only stocks.
DATABASE_URL=
# Coinbase Developer Platform: OnchainKit + paymaster
CDP_PROJECT_ID=
NEXT_PUBLIC_CDP_PROJECT_ID=

# --- Optional ---
# Base RPC for packages/universe/scripts/verify.ts (default: mainnet.base.org)
BASE_RPC_URL=
